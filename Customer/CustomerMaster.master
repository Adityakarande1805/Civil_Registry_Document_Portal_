</head>
<body>
  
    <form id="form2" runat="server">
    
    <table align="center" cellpadding="0" class="style1" cellspacing="0" 
        style="font-family: 'Century Gothic'">
        <tr>
            <td>
                <strong>&nbsp;&nbsp;<span class="style13">CIVIL REGISTRATION</span><span class="style7"><asp:Button ID="Button1" runat="server" AccessKey="u" BackColor="White" 
                    BorderStyle="None" ForeColor="White" PostBackUrl="~/Admin/AdminLogin.aspx" 
                    Text="Button" />
                </span></strong></td>
            <td color: #FF6600" 
                class="style6">
                <table align="right" cellpadding="3">
                    <tr>
                        <td>
                            <asp:Image ID="Image4" runat="server" Height="40px" 
                                ImageUrl="~/Images/Right-Serve.png" Width="40px" />
                        </td>
                        <td class="style8">
                            
                            <strong>YOUR SERVICE IS OUR DUTY&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                            </strong></td>
                        <td class="style8">
                            
                            <asp:Image ID="Image3" runat="server" Height="25px" 
                                ImageUrl="~/Images/edit-user-xl.png" Width="25px" />
                        </td>
                        <td class="style8">
                            
                            Welcome&nbsp;&nbsp;&nbsp; <strong>
                <asp:Label ID="Label1" runat="server" Text="Label" ForeColor="#FF9900" 
                    style="color: #000000"></asp:Label>
                            </strong>&nbsp;
                        </td>
                    </tr>
                </table>
                          </td>
        </tr>
        <tr>
            <td class="style4" colspan="2">
                <table align="center" cellpadding="0" cellspacing="0" class="style9">
                    <tr>
                        <td bgcolor="#990000">
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; 
                            &nbsp;</td>
                        <td bgcolor="#990000">
                            <asp:Image ID="Image5" runat="server" Height="20px" 
                                ImageUrl="~/Images/home-xl.png" Width="20px" />
                        </td>
                        <td bgcolor="#990000" class="style14">
                <asp:Menu ID="Menu2" runat="server" BackColor="#990000" Font-Bold="True" 
                    ForeColor="White" Height="35px" Orientation="Horizontal" RenderingMode="Table" 
                    StaticEnableDefaultPopOutImage="False" Width="100%" 
                    style="margin-top: 0px" CssClass="style5">
                    <DynamicMenuItemStyle BackColor="#990000" HorizontalPadding="10px" 
                        VerticalPadding="5px" />
                    <Items>
                        <asp:MenuItem Text="Home" Value="Home" NavigateUrl="~/Customer/Home.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="My Profile" Value="My Profile" 
                            NavigateUrl="~/Customer/MyProfile.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Certificates" Value="Certificates">
                            <asp:MenuItem NavigateUrl="~/Customer/AdhaarCard.aspx" Text="Adhaar Card" 
