                            <asp:MenuItem NavigateUrl="~/Customer/BirthCertificate.aspx" 
                                Text="Birth Certificate" Value="Birth Certificate"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/DeathCertificate.aspx" 
                                Text="Death Certificate" Value="Death Certificate"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/MarriageCertificate.aspx" 
                                Text="Marriage Certificate" Value="Marriage Certificate"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/Pancard.aspx" Text="Pancard" 
                                Value="Pancard"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/Voterid.aspx" Text="voterid" 
                                Value="voterid"></asp:MenuItem>
                        </asp:MenuItem>
                        <asp:MenuItem Text="Feedback" Value="Feedback" 
                            NavigateUrl="~/Customer/Feedback.aspx"></asp:MenuItem>
                        <asp:MenuItem Text="Report" Value="Report">
                            <asp:MenuItem NavigateUrl="~/Customer/Adhaar Card Report.aspx" 
                                Text="Adhaar Card Report" Value="Adhaar Card Report"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/BirthCertificateReport.aspx" 
                                Text="Birth Certificate Report" Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/DeathCertificateReport.aspx" 
                                Text="Death Certificate Report" Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/MarriageCertificateReport.aspx" 
                                Text="Marriage Certificate Report" Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/PanCardReport.aspx" 
                                Text="Pan Card Report" Value="New Item"></asp:MenuItem>
                            <asp:MenuItem NavigateUrl="~/Customer/VoterIdReport.aspx" 
                                Text="Voter Id Report" Value="New Item"></asp:MenuItem>
                        </asp:MenuItem>
                        <asp:MenuItem Text="Logout" Value="Logout" NavigateUrl="~/User/Home.aspx"></asp:MenuItem>
                    </Items>
                </asp:Menu>
                        </td>
                        <td bgcolor="#990000">
                            &nbsp;</td>
                        <td bgcolor="#990000">
                            &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp; &nbsp;</td>
                    </tr>
                </table>
            </td>
